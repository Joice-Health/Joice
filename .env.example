# ---- Database ----
# Host port the docker-compose Postgres is published on (change if 5432 is taken).
POSTGRES_PORT=5432
# Local dev (host): connect to the Postgres exposed by docker-compose
DATABASE_URL=postgresql://joice:joice@localhost:5432/joice

# ---- API (apps/api) ----
PORT=4000
# ---- Brain (apps/brain) — chat + voice, everything under /api/brain/* ----
BRAIN_PORT=4100
# Comma-separated list of allowed browser origins for CORS
WEB_ORIGIN=http://localhost:3000
# How many trailing X-Forwarded-For hops our infra appends (CloudFront + ALB = 2 in prod).
TRUSTED_PROXY_HOPS=0

# ---- Web (apps/web) ----
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public base URL of the web app (used to build referral share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Clerk (admin auth) ----
# Dev-instance keys from https://dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Clerk instance JWT public key (Dashboard -> API keys -> JWT public key, PEM).
# The brain verifies member tokens with it and never holds the secret key; in
# local dev leaving it empty makes the brain fall back to CLERK_SECRET_KEY.
CLERK_JWT_KEY=
# Server-side base URL for the API (used by server components; defaults sensibly in dev).
API_URL_INTERNAL=http://localhost:4000

# ---- Klaviyo (waitlist marketing sync) ----
# Private API key (Settings → API Keys; scopes: Profiles Full, Subscriptions
# Full, Lists Full, Events Full) and the master consent list ID (6-char code
# in the list URL). Set both or neither (the API refuses to boot half-set);
# both empty disables the sync — signups still work, nothing syncs.
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# ---- Onboarding (intake on /get-started) ----
# Retention for anonymous intake sessions: idle this many days -> abandoned;
# unclaimed for the TTL -> answers, observations and profile purged by the
# sweep. Registered sessions never expire. Counsel confirms the numbers.
ONBOARDING_SESSION_IDLE_DAYS=30
ONBOARDING_SESSION_TTL_DAYS=90
# PHI key 1 of 2. Leave false until the Before-PHI checklist (infra/README.md)
# is complete; in prod it is a Terraform variable, never an admin toggle. With
# the onboarding_health flag on, health-tier questions can be published.
PHI_READY=false

# ---- RAG chatbot (Bedrock — IAM-authenticated, no API keys) ----
# Bedrock model for answers (cross-region inference profile id). Until the
# account's Anthropic use-case form is approved, use us.amazon.nova-pro-v1:0.
RAG_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1
# Polly neural voice for spoken answers (voice mode on /ask).
POLLY_VOICE_ID=Ruth
# Local dev needs AWS creds with Bedrock access (e.g. export AWS_PROFILE creds
# into these, or leave empty — chat endpoints fail, everything else works).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Ingestion source — set exactly ONE when running apps/brain/scripts/ingest.ts:
# S3 bucket of PHI-reviewed notes (prod), or a local folder (dev; fixtures at
# apps/brain/fixtures/sample-notes).
NOTES_BUCKET=
NOTES_DIR=

# Persist chat threads (conversations + messages tables). OFF everywhere by
# default: storing member questions crosses the Phase-0 "marketing data only"
# line. See docs/rag/07-compliance.md before enabling.
BRAIN_PERSIST_CONVERSATIONS=false
# Base URL of the brain service. Empty in prod (same CloudFront origin); set
# locally only when running the dev servers directly on the host.
NEXT_PUBLIC_BRAIN_URL=http://localhost:4100

# ---- Team preview gate ----
# Shared password for the in-progress main site (/team to log in).
TEAM_PASSWORD=joice-dev
# Set to "true" at launch to open the main site to everyone (removes the gate).
SITE_LAUNCHED=false
