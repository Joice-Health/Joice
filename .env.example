# ---- Database ----
# Host port the docker-compose Postgres is published on (change if 5432 is taken).
POSTGRES_PORT=5432
# Local dev (host): connect to the Postgres exposed by docker-compose
DATABASE_URL=postgresql://joice:joice@localhost:5432/joice

# ---- API (apps/api) ----
PORT=4000
# Comma-separated list of allowed browser origins for CORS
WEB_ORIGIN=http://localhost:3000

# ---- Web (apps/web) ----
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public base URL of the web app (used to build referral share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Clerk (admin auth) ----
# Dev-instance keys from https://dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Server-side base URL for the API (used by server components; defaults sensibly in dev).
API_URL_INTERNAL=http://localhost:4000

# ---- RAG chatbot (Bedrock — IAM-authenticated, no API keys) ----
# Bedrock model for answers (cross-region inference profile id).
RAG_MODEL=us.anthropic.claude-sonnet-5
BEDROCK_REGION=us-east-1
# Local dev needs AWS creds with Bedrock access (e.g. export AWS_PROFILE creds
# into these, or leave empty — chat endpoints fail, everything else works).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Ingestion source — set exactly ONE when running apps/api/scripts/ingest.ts:
# S3 bucket of PHI-reviewed notes (prod), or a local folder (dev; fixtures at
# apps/api/fixtures/sample-notes).
NOTES_BUCKET=
NOTES_DIR=

# ---- Team preview gate ----
# Shared password for the in-progress main site (/team to log in).
TEAM_PASSWORD=joice-dev
# Set to "true" at launch to open the main site to everyone (removes the gate).
SITE_LAUNCHED=false
