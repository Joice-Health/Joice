# ---- Database ----
# Host port the docker-compose Postgres is published on (change if 5432 is taken).
POSTGRES_PORT=5432
# Local dev (host): connect to the Postgres exposed by docker-compose
DATABASE_URL=postgresql://joice:joice@localhost:5432/joice

# ---- API (apps/api) ----
PORT=4000
# Comma-separated list of allowed browser origins for CORS
WEB_ORIGIN=http://localhost:3000

# ---- Web (apps/web) ----
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public base URL of the web app (used to build referral share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
